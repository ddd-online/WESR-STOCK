# 官方示例包（约 680 MB，可重新下载，见 references/DOWNLOAD.md）
references/official/
references/_archives/

# 3D 模型体积较大
references/datasheets/*.rar

# 构建产物
build/
managed_components/
sdkconfig.old

# 固件里从官方工程裁剪掉、暂时留着备查的部分（Task 1）
firmware/_pruned/
# 第三方头文件库（20MB，Bosch/Touch 全量头）；本地保留、不入库，
# 重建方式见 references/DOWNLOAD.md（从官方 Demo 包 Copy 回来），i2c_equipment.cpp 的 RTC 依赖它
firmware/components/ExternLib/
# 字体是本机生成的构建产物（许可原因不入库，用 tools/gen_fonts.ps1 重建）
firmware/components/wesr/ui/font_*.c
# sdkconfig 由 sdkconfig.defaults 生成；本地这份里放着 WiFi 凭据（menuconfig），不能进仓库
firmware/sdkconfig
# 本地 WiFi 凭据覆盖层（构建时用 SDKCONFIG_DEFAULTS 拼在 defaults 后面，见 firmware/README §3）
firmware/sdkconfig.wifi
firmware/sdkconfig.bak.*
firmware/sdkconfig.old

# 编辑器/工具的本机配置：里面是本机绝对路径，入库会污染别人的环境
.vscode/
# 微信开发者工具的机器本地配置（appid/libVersion/编译开关等）
miniprogram/project.private.config.json
