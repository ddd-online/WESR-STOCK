/* 三个页面共用：卡片 + 一行两列（左标签右值）。1-bit 屏那套视觉不管这儿。 */
page { background: #f2f2f2; font-size: 28rpx; }
.pad { padding: 24rpx; }
.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx;
}
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0; border-bottom: 1rpx solid #eee;
}
.row:last-child { border-bottom: none; }
.muted { color: #888; }
.hint {
  background: #fff8e1; color: #8a6d00; padding: 20rpx; border-radius: 12rpx;
  margin-bottom: 24rpx; line-height: 1.5;
}
.tip { color: #c62828; padding: 16rpx 0; line-height: 1.5; }
.ok { color: #2e7d32; padding: 16rpx 0; line-height: 1.5; }
.btn { margin-top: 16rpx; background: #000; color: #fff; }
.btn.plain { background: #fff; color: #333; border: 1rpx solid #ddd; }
.pick { background: #f7f7f7; border-radius: 8rpx; padding: 16rpx; margin: 8rpx 0; }
input { padding: 16rpx; background: #f7f7f7; border-radius: 8rpx; margin: 8rpx 0; }
